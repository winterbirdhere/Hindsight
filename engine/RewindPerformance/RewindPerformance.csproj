<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>RewindPerformance</AssemblyName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="[2026.730.0]" />
    <PackageReference Include="ppy.osu.Game.Resources" Version="[2026.710.0]" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="ppy.osu.Framework.NativeLibs" Version="[2025.806.0-nativelibs]" ExcludeAssets="runtime;native" PrivateAssets="all" />
  </ItemGroup>
</Project>
