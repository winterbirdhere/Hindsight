{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictNullChecks": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2022",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@rewind/osu-performance/*": [
        "libs/osu/performance/src/*"
      ],
      "@osujs/core": [
        "libs/osu/core/src/index.ts"
      ],
      "@osujs/math": [
        "libs/osu/math/src/index.ts"
      ],
      "@osujs/pp": [
        "libs/osu/pp/src/index.ts"
      ],
      "@rewind/osu-local/db-reader": [
        "libs/osu-local/db-reader/src/index.ts"
      ],
      "@rewind/osu-local/db-reader/library-scores": [
        "libs/osu-local/db-reader/src/library-scores.ts"
      ],
      "@rewind/osu-local/db-reader/library-maps": [
        "libs/osu-local/db-reader/src/library-maps.ts"
      ],
      "@rewind/osu-local/gosumemory": [
        "libs/osu-local/gosumemory/src/index.ts"
      ],
      "@rewind/osu-local/osr-reader": [
        "libs/osu-local/osr-reader/src/index.ts"
      ],
      "@rewind/osu-local/osr-reader/header": [
        "libs/osu-local/osr-reader/src/header.ts"
      ],
      "@rewind/osu-local/skin-reader": [
        "libs/osu-local/skin-reader/src/index.ts"
      ],
      "@rewind/osu-local/utils": [
        "libs/osu-local/utils/src/index.ts"
      ],
      "@rewind/osu-pixi/classic-components": [
        "libs/osu-pixi/classic-components/src/index.ts"
      ],
      "@rewind/osu-pixi/rewind": [
        "libs/osu-pixi/rewind/src/index.ts"
      ],
      "@rewind/osu/skin": [
        "libs/osu/skin/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
