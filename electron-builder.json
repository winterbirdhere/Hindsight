{
  "appId": "dev.hindsight.app",
  "productName": "Hindsight",
  "copyright": "Copyright (c) 2021 abstrakt",
  "afterPack": "tools/media/after-pack.cjs",
  "extraMetadata": {
    "productName": "Hindsight"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "icon": "apps/desktop/frontend/src/favicon.ico"
  },
  "directories": {
    "output": "dist/electron",
    "buildResources": "tools/electron-builder/build-resources",
    "app": "."
  },
  "snap": {
    "publish": ["github"]
  },
  "files": [
    {
      "from": "dist/apps/desktop",
      "filter": ["index.js", "library-utility.js", "library-resource-utility.js", "library-analysis-utility.js", "replay-read-worker.js", "assets"]
    },
    {
      "from": "dist/apps/desktop/frontend",
      "to": "frontend"
    },
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/clip-media",
      "to": "clip-media",
      "filter": ["runtime.json", "runtime-lock.json", "README.md", "win-x64/*"]
    },
    {
      "from": "resources/third-party-notices/ffmpeg",
      "to": "third-party-notices/ffmpeg",
      "filter": ["*.zip"]
    },
    {
      "from": "resources/performance-engine",
      "to": "performance-engine"
    },
    {
      "from": "resources/Skins",
      "to": "Skins"
    },
    {
      "from": "LICENSE.md",
      "to": "LICENSE.md"
    }
  ]
}
